<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FabrikamAgentAssist.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="GoodBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FFB900" />
            <SolidColorBrush x:Key="BadBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="NeutralBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="PanelBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#4CC2FF" />

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="#B3FFFFFF" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
